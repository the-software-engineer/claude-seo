# Umami self-hosted analytics credentials.
#
# Source of truth: 1Password TSE vault, item "Umami". Copy this file
# and fill the values from the 1P item.
#
# Where to put the populated copy (the script reads the first match it
# finds, and shell env vars override either):
#
#   1. $UMAMI_ENV_FILE if set (explicit override).
#   2. ~/.config/claude-seo/umami.env  <- recommended post-install,
#      cwd-independent so /seo umami works from any Claude session,
#      including when invoked through the installed plugin cache.
#   3. .env at this repo root (dev convenience from a checkout).
#
# Pattern: Foundry service-credentials standard
# (../the-foundry/standards/service-credentials.md).
# The same credential is consumed by `bearings`.

UMAMI_USERNAME=
UMAMI_PASSWORD=

# Optional. Override the default Umami host.
# UMAMI_BASE_URL=https://analytics.crafts.software

# Optional. Default --website-id for umami_stats.py. Run
# `python scripts/umami_stats.py check` to list available UUIDs.
# UMAMI_WEBSITE_ID=
